# =================================================================
# HomeJoy Backend Environment Template
# Copy this file to .env and fill in your genuine credentials
# =================================================================

# MongoDB Atlas Connection URI
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=homejoy

# JWT Security (Must be at least 32 characters; server refuses to start with empty/default key)
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production Allowed Origins (Comma-separated for multiple domains; wildcards forbidden)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth Client ID (for token aud verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# -----------------------------------------------------------------
# Free SMTP Email Configuration (Zero Cost / Python smtplib)
# -----------------------------------------------------------------
# EMAIL_MODE: 'console' writes emails to stdout/local logs for demo without credentials;
#             'smtp' connects to your SMTP server (e.g. Gmail App Password).
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true

# Optional daily report auto-send scheduler (IST 20:00)
AUTO_SEND_DAILY_REPORTS=false
AUTO_SEND_TIME=20:00

